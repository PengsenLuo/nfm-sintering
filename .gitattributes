# 文本文件统一用 LF,Windows 上 git add 时不再被转成 CRLF。
* text=auto eol=lf

*.py  text eol=lf
*.md  text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.toml text eol=lf
*.txt  text eol=lf
*.csv  text eol=lf
*.cfg  text eol=lf
*.ini  text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf

# 二进制文件:不做任何换行符转换
*.png  binary
*.jpg  binary
*.jpeg binary
*.tif  binary
*.tiff binary
*.pth  binary
*.docx binary
*.pdf  binary
